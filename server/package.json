{
  "name": "powerhouse-server",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on Powerhouse workflow coordinator: DBOS + Postgres + boxd execution.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@boxd-sh/sdk": "0.2.10",
    "@dbos-inc/dbos-sdk": "5.0.2",
    "fastify": "5.12.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
