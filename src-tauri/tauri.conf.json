{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Powerhouse",
  "version": "0.1.4",
  "identifier": "com.mithril.powerhouse",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Powerhouse",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNjhDNUQwNkU3OEFBMjYKUldRbXFuaHUwTVZvbzErU1FIT2E0a0V4WDRUK3ZBQk1iTlFvOW8ySzJKRkFWUUxPRmY0QzIyamEK",
      "endpoints": [
        "https://github.com/mithril-studio/powerhouse-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
